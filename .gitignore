# Large data directories (exclude most)
data/
public_data
public_data/
outputs/
models/
.vendor/

# Exception: annotation app data (includes database)
!annotation/public_video_annot/data/
# Exclude large .db files but include compressed SQL export
annotation/public_video_annot/data/*.db
annotation/public_video_annot/data/*.db.backup*
!annotation/public_video_annot/data/*.sql.gz

# Exclude video data from annotation dirs
annotation/public_video_annot/missing_normal_videos/
annotation/public_video_annot/missing_score_videos/

# Large batch output directories
public_data_filter/batch_outputs/

# Database files (exclude others)
*.db
*.db.backup*

# Python cache
__pycache__/
*.pyc
*.pyo

# Virtual environment
venv/
.venv/

# IDE
.idea/
.vscode/

# Logs
*.log
*.log.*
nohup.out
logs/
worker_logs/

# Temporary files
.tmp/
*.tmp

# Large archives
*.zip
*.tar
*.tar.gz

# Self-clone
Ano-agent/

# Symlinks to external data/models
bert-base-uncased

# External model repos
code/

