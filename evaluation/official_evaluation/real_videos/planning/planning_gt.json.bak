  },
  {
    "video_id": "SmartHome-Bench/videos/smartbench_0002",
    "risk_status": "abnormal",
    "person_solution": "立即稳定婴儿车，检查车内婴儿是否受到惊吓或碰撞。",
    "hazard_solution": "在停止婴儿车时及时踩下刹车装置，防止车辆滑动。",
    "prevention_solution": "培养“停车即刹车”的习惯，无论停留时间长短都及时锁定婴儿车。"
  },
  {
    "video_id": "SmartHome-Bench/videos/smartbench_0003",
    "risk_status": "risk_only",
    "person_solution": "提醒人员不要靠近或惊扰火鸡，避免其受惊后突然飞扑或坠落造成人员受伤。",
    "hazard_solution": "将火鸡从栏杆等高风险位置引导或驱离，避免其在不稳定结构上停留。",
    "prevention_solution": "避免在后院长期暴露食物残渣、宠物饲料或可吸引鸟类/禽类的物品。"
  },
  {
    "video_id": "SmartHome-Bench/videos/smartbench_0004",
    "risk_status": "normal",
    "person_solution": "",
    "hazard_solution": "",
    "prevention_solution": ""
  },
  {
    "video_id": "SmartHome-Bench/videos/smartbench_0005",
    "risk_status": "normal",
    "person_solution": "",
    "hazard_solution": "",
    "prevention_solution": ""
  },
  {
    "video_id": "SmartHome-Bench/videos/smartbench_0006",
    "risk_status": "risk_only",
    "person_solution": "屋内人员不要外出靠近、拍摄或驱赶狼，儿童、老人和宠物应留在室内安全区域。若发现狼仍在院中，应关闭门窗，并通过监控观察其动向。",
    "hazard_solution": "不要投喂、追赶或用强光、噪声刺激狼，以免引发攻击或防御行为。应等待其自行离开。若狼长时间停留、反复出现或靠近住宅入口，应联系当地野生动物管理部门或相关执法部门处理。",
    "prevention_solution": "院子中不要放置宠物粮、垃圾、食物残渣或家禽饲料等可能吸引野生动物的物品。夜间不要让宠物单独外出，可加固围栏、增加感应灯和监控设备，降低狼再次进入院子的可能性。"
  },
  {
    "video_id": "SmartHome-Bench/videos/smartbench_0007",
    "risk_status": "risk_only",
    "person_solution": "人员应留在室内，不要靠近、追赶或试图抢回垃圾桶。儿童、老人和宠物应远离庭院和门口区域，避免与熊发生近距离接触。若熊尚未完全离开周边区域，应继续通过监控观察其动向，待确认安全后再外出处理现场。",
    "hazard_solution": "不要通过喊叫、投掷物品或靠近熊进行驱赶，以免刺激其攻击或突然逃窜。待熊离开后，应检查庭院和周边区域是否有散落垃圾、食物残渣或被破坏的设施，并及时清理。若垃圾桶已经损坏，应更换为更加牢固、防动物开启的类型。",
    "prevention_solution": "垃圾桶应使用加盖、防翻倒和防动物开启设计，并尽量存放在封闭车库、储物间或围栏区域内。不要在庭院长期放置厨余、宠物粮、烧烤残渣或其他带气味物品。夜间可增加感应灯、监控和异常提醒装置，并减少垃圾长时间暴露在室外，降低熊再次进入庭院觅食的可能。"
  },
  {
    "video_id": "SmartHome-Bench/videos/smartbench_0008",
    "risk_status": "risk_only",
    "person_solution": "保持距离观察松鼠行为，避免靠近或尝试驱赶，防止其受惊后反扑或咬伤。",
    "hazard_solution": "清理栏杆及周边可能吸引松鼠的食物残留（如果皮、零食、鸟食）。",
    "prevention_solution": "定期清理前院环境，减少坚果类、食物类或垃圾类吸引源。"
  },
  {
    "video_id": "SmartHome-Bench/videos/smartbench_0009",
    "risk_status": "normal",
    "person_solution": "",
    "hazard_solution": "",
    "prevention_solution": ""
  },
  {
