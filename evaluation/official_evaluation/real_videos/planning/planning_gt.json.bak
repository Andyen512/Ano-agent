  {
    "video_id": "SmartHome-Bench/videos/smartbench_0380",
    "risk_status": "risk_only",
    "person_solution": "屋内人员不要靠近或驱赶野猪，儿童、老人和宠物应远离庭院区域。若有人在户外，应缓慢退回室内，避免突然动作、尖叫或试图接近拍摄。",
    "hazard_solution": "不要投喂、追赶或用物品刺激野猪，以免其受惊后冲撞。应通过监控或安全距离观察其动向，等待其自行离开。确认安全后，再检查垃圾桶是否被翻动，并及时清理散落垃圾。",
    "prevention_solution": "垃圾桶应加盖固定，并尽量减少食物残渣气味外泄。宠物粮、厨余垃圾和烧烤残渣不要长期放置在庭院。可增加围栏、感应灯和监控设备，减少野猪再次进入庭院的可能性。"
  },
  {
    "video_id": "SmartHome-Bench/videos/smartbench_0381",
    "risk_status": "abnormal",
    "person_solution": "立即提醒停车场附近人员不要靠近可疑人员，保持安全距离。",
    "hazard_solution": "检查被盗车辆和周边车辆是否存在异常痕迹、门窗未锁或物品丢失情况。",
    "prevention_solution": "对车辆加强防盗措施，如使用方向盘锁、防盗报警、GPS定位和远程锁车功能。"
  },
  {
    "video_id": "SmartHome-Bench/videos/smartbench_0382",
    "risk_status": "normal",
    "person_solution": "",
    "hazard_solution": "",
    "prevention_solution": ""
  },
  {
    "video_id": "SmartHome-Bench/videos/smartbench_0383",
    "risk_status": "normal",
    "person_solution": "",
    "hazard_solution": "",
    "prevention_solution": ""
  },
  {
    "video_id": "SmartHome-Bench/videos/smartbench_0384",
    "risk_status": "risk_only",
    "person_solution": "屋内人员不要外出追赶或质问该人员，应保持门窗关闭并确认家人安全。应保存监控录像，记录嫌疑人的外貌、衣着、行动路线和逃离方向，必要时报警处理。",
    "hazard_solution": "待确认嫌疑人离开后，再检查车辆车门、车窗、车内物品、手套箱、后备箱和车辆钥匙是否有被翻动、遗失或损坏情况。若发现财物丢失或车辆异常，应及时联系警方。",
    "prevention_solution": "车辆停放后应确保车门车窗锁闭，不要在车内放置现金、包、钥匙、电子设备等显眼贵重物品。院子和车道区域可增加感应灯、监控摄像头、车辆报警器和门口照明，提高夜间防盗能力。"
  },
  {
    "video_id": "SmartHome-Bench/videos/smartbench_0385",
    "risk_status": "normal",
    "person_solution": "",
    "hazard_solution": "",
    "prevention_solution": ""
  },
  {
    "video_id": "SmartHome-Bench/videos/smartbench_0386",
    "risk_status": "normal",
    "person_solution": "",
    "hazard_solution": "",
    "prevention_solution": ""
  },
  {
    "video_id": "SmartHome-Bench/videos/smartbench_0387",
    "risk_status": "abnormal",
    "person_solution": "屋内人员应留在室内安全区域，不要开门或单独外出追赶。应立即锁好门窗，确认家人安全，并及时报警。若有监控录像，应保存视频作为证据。",
    "hazard_solution": "可通过门铃摄像头、远程语音警示、报警器或开启门口灯光进行威慑，但不要近距离接触嫌疑人。待确认对方离开后，再检查门锁、门框和门口区域是否有撬动或损坏痕迹。",
    "prevention_solution": "门口应安装可靠门锁、防撬门链、门磁报警器、监控摄像头和感应灯。夜间保持门窗上锁，不要在门口显眼位置放置钥匙或贵重物品。若附近反复出现类似情况，应及时向警方和社区反馈，加强巡查和邻里联防。"
  },
